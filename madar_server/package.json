{
  "name": "madar-workspace-server",
  "version": "1.0.0",
  "description": "Madar Self-Hosted Sovereign Workspace Server — E2EE messaging, channels, broadcasts, calls, policy engine, and directory (Node.js + PostgreSQL + WebSocket)",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "madarctl": "bin/madarctl.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "migrate": "node src/db/migrate.js",
    "madarctl": "node bin/madarctl.js",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "lint": "node --check src/index.js"
  },
  "author": "Madar Team",
  "license": "AGPL-3.0-only",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1153.0",
    "@aws-sdk/s3-request-presigner": "^3.1153.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "ffmpeg-static": "^5.3.0",
    "fluent-ffmpeg": "^2.1.3",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "libphonenumber-js": "^1.13.15",
    "multer": "^2.4.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "pino-pretty": "^13.2.0"
  }
}
