# ==============================================================================
# Madar Self-Hosted Sovereign Workspace — Setup Configuration (.env.setup)
# Copy to .env.setup and run: ./setup.sh --non-interactive
# ==============================================================================

# Deployment mode: "docker" (Docker Compose stack) or "native" (Host Node.js + PostgreSQL)
DEPLOY_MODE=docker

# Environment: "development" (local HTTP) or "production" (HTTPS + TLS via Caddy)
APP_ENV=development

# Organization / Workspace Metadata
WORKSPACE_SLUG=org-hq
WORKSPACE_DEFAULT_NAME="مساحة عمل مدار السيادية"
ADMIN_EMAIL=admin@madar.local
# Leave empty to generate a random password (saved to .env as ADMIN_PASSWORD)
ADMIN_PASSWORD=

# Network & Ports
PUBLIC_HOST=localhost
API_PORT=5025
ADMIN_CONSOLE_PORT=5030
MINIO_PORT=9000
STUN_PORT=3478
TURN_PORT=3479

# Optional custom domains (used when APP_ENV=production)
API_DOMAIN=
ADMIN_DOMAIN=
CDN_DOMAIN=

# Extra browser origins allowed to call the API in production (comma-separated).
# Add the web client URL your users open, e.g. https://app.protosoftdev.online
CORS_ORIGINS=

# Database (used in native mode or overridden in docker mode)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=madar
DB_USER=postgres
# Leave empty to generate a random password
DB_PASSWORD=
